rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIsoDate(val) {
      return val is string
        && val.size() == 10
        && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function ownerProfileExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2: Anti-Update-Gap)
    // Synchronized verbatim with firebase-blueprint.json
    // =========================================================================

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == request.auth.token.email
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGymBranding(data, userId) {
      return data.keys().hasAll(['ownerId', 'gymName', 'currency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'gymName', 'currency', 'logoUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.gymName is string
        && data.gymName.size() >= 1
        && data.gymName.size() <= 48
        && data.currency is string
        && data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'AUD']
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 200000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGymMember(data, userId, memberId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'phone', 'plan', 'fees', 'amountPaid',
          'paymentMode', 'manualStatus', 'paidDate', 'renewalDate', 'joinedDate',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'phone', 'email', 'plan', 'fees', 'amountPaid',
          'paymentMode', 'manualStatus', 'paidDate', 'renewalDate', 'joinedDate',
          'avatarUrl', 'notes', 'lastMessagedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == memberId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() >= 1
        && data.phone.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && data.plan is string
        && data.plan in ['1 Month', '2 Months', '3 Months', '6 Months', '12 Months']
        && data.fees is number
        && data.fees > 0
        && data.fees <= 10000000
        && data.amountPaid is number
        && data.amountPaid >= 0
        && data.amountPaid <= data.fees
        && data.paymentMode is string
        && data.paymentMode in ['Cash', 'UPI', 'Card']
        && data.manualStatus is string
        && data.manualStatus in ['active', 'paused']
        && isValidIsoDate(data.paidDate)
        && isValidIsoDate(data.renewalDate)
        && isValidIsoDate(data.joinedDate)
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('lastMessagedAt' in data) || (data.lastMessagedAt is string && data.lastMessagedAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /users/{userId} {
      // Strictly isolated PII: owner-only get (no list on /users collection)
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if isValidId(userId) && isOwner(userId);

      // Subcollection: Gym Branding Settings (/users/{userId}/settings/{settingId})
      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if false;

        allow create: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'branding'
          && isOwner(userId)
          && isValidGymBranding(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && ownerProfileExists(userId);

        allow update: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'branding'
          && isOwner(userId)
          && isValidGymBranding(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['gymName', 'currency', 'logoUrl', 'updatedAt'])
          && ownerProfileExists(userId);

        allow delete: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      // Subcollection: Gym Members (/users/{userId}/members/{memberId})
      match /members/{memberId} {
        allow get: if isValidId(userId) && isValidId(memberId) && isOwner(userId);
        // Pillar 8: Secure list query checking resource.data.ownerId directly (no get()/exists() in list)
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(memberId)
          && isOwner(userId)
          && isValidGymMember(incoming(), userId, memberId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && ownerProfileExists(userId);

        // Pillar 4.5: Action-Based Updates wrapped in isValidGymMember
        allow update: if isValidId(userId)
          && isValidId(memberId)
          && isOwner(userId)
          && isValidGymMember(incoming(), userId, memberId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Record quick payment / settle balance / renew
            incoming().diff(existing()).affectedKeys().hasOnly([
              'paidDate', 'renewalDate', 'paymentMode', 'amountPaid', 'manualStatus', 'updatedAt'
            ])
            ||
            // Action 2: Record WhatsApp / Email outreach timestamp
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagedAt', 'updatedAt'])
            ||
            // Action 3: Full owner profile edit of member details
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'email', 'plan', 'fees', 'amountPaid',
              'paymentMode', 'manualStatus', 'paidDate', 'renewalDate',
              'joinedDate', 'avatarUrl', 'notes', 'updatedAt'
            ])
          )
          && ownerProfileExists(userId);

        allow delete: if isValidId(userId) && isValidId(memberId) && isOwner(userId);
      }
    }
  }
}
