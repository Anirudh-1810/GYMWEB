{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated gym owner profile synced from Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name from Google account."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Google account email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024,
          "description": "Optional Google profile photo URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when owner profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when owner profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "GymBrandingDoc": {
      "title": "GymBrandingDoc",
      "description": "Custom gym name, logo image, and preferred currency for an authenticated gym owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document."
        },
        "gymName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Custom display name of the gym."
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP", "AED", "AUD"],
          "description": "Preferred currency code for fees and revenue summaries."
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Optional custom gym logo URL or resized PNG data URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were last updated."
        }
      },
      "required": ["ownerId", "gymName", "currency", "createdAt", "updatedAt"]
    },
    "GymMemberDoc": {
      "title": "GymMemberDoc",
      "description": "Gym client record containing contact info, membership plan, fees, payment mode, and due dates.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique member identifier matching document ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name of the gym member."
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Member phone or WhatsApp number."
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Optional member email address."
        },
        "plan": {
          "type": "string",
          "enum": ["1 Month", "2 Months", "3 Months", "6 Months", "12 Months"],
          "description": "Membership billing plan duration."
        },
        "fees": {
          "type": "number",
          "description": "Total plan fee amount."
        },
        "amountPaid": {
          "type": "number",
          "description": "Amount paid so far toward fees (0 <= amountPaid <= fees)."
        },
        "paymentMode": {
          "type": "string",
          "enum": ["Cash", "UPI", "Card"],
          "description": "Payment method used to sort gym funds."
        },
        "manualStatus": {
          "type": "string",
          "enum": ["active", "paused"],
          "description": "Manual active/paused toggle."
        },
        "paidDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date fees were paid (YYYY-MM-DD)."
        },
        "renewalDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Next fee due date (YYYY-MM-DD)."
        },
        "joinedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date member joined (YYYY-MM-DD)."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Optional member profile image URL or resized data URL."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional trainer or front-desk notes."
        },
        "lastMessagedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional ISO timestamp of most recent WhatsApp/email outreach."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when member record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when member record was last updated."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "phone",
        "plan",
        "fees",
        "amountPaid",
        "paymentMode",
        "manualStatus",
        "paidDate",
        "renewalDate",
        "joinedDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private authenticated gym owner profile isolated strictly to userId."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/GymBrandingDoc" },
      "description": "Gym branding settings (gymName, currency, logoUrl) scoped to the authenticated owner."
    },
    "/users/{userId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GymMemberDoc" },
      "description": "Private gym client roster records scoped strictly to the authenticated owner."
    }
  }
}
